{
  "expo": {
    "name": "Nearby",
    "slug": "wearable",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "nearby",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nearby.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Nearby uses Bluetooth to find and link your wearable ring, and to notice other Nearby rings when you walk by.",
        "NSBluetoothPeripheralUsageDescription": "Nearby uses Bluetooth to find and link your wearable ring."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#CCFBF1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.nearby.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Nearby to use your photos for your profile."
        }
      ],
      "expo-font",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Nearby uses Bluetooth to find and link your wearable ring, and to notice other Nearby rings when you walk by."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "53cd2c2f-95e3-4fb2-ab7b-97cd1cacb70d"
      }
    },
    "owner": "jubileeinvestments"
  }
}
