PORT=4000
# Firebase Admin — pick ONE:
# A) Local: path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=
# B) Render/hosting: paste the full JSON as a single-line env var
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# Optional — icebreaker agent (falls back to mock without a key)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Calendar connector (Talk → Connect Google)
# Create an OAuth "Web application" client in Google Cloud Console.
# Enable Google Calendar API. Authorized redirect URI must match exactly:
#   http://localhost:4000/v1/connectors/google/calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/v1/connectors/google/calendar/callback
API_PUBLIC_URL=http://localhost:4000
APP_BASE_URL=http://localhost:3000
# Optional; defaults to GOOGLE_CLIENT_SECRET
CONNECTOR_STATE_SECRET=

# Stripe (Nearby+ subscription) — web Checkout + Customer Portal
# Create a Product "Nearby+" with a recurring Price in Stripe Dashboard,
# then paste the price_… id below.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_NEARBY_PLUS=
STRIPE_WEBHOOK_SECRET=
# Where Checkout/Portal redirects after pay / cancel
APP_BASE_URL=http://localhost:3000
