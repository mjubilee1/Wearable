PORT=4000
# Firebase Admin — pick ONE:
# A) Local: path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=
# B) Render/hosting: paste the full JSON as a single-line env var
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# Optional — icebreaker agent (falls back to mock without a key)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Read-only web search (Tavily). Used when a question needs current public info.
# Create a key at https://tavily.com and paste it here. Never commit the value.
SEARCH_API_KEY=

# OpenStreetMap place discovery. Public defaults work for light local use;
# set a truthful contact URL/email in the user agent before production traffic.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# Optional comma-separated failover list; takes precedence over the URL above.
OVERPASS_API_URLS=
NOMINATIM_API_URL=https://nominatim.openstreetmap.org
OSM_USER_AGENT=NearbyHello/0.1 (https://nearbyhello.com)
PLACES_PROVIDER_TIMEOUT_MS=8000
PLACES_CACHE_TTL_MS=21600000
# Optional authenticated hook for a hosting scheduler.
SPATIAL_SYNC_SECRET=
SPATIAL_PILOT_LATITUDE=38.9072
SPATIAL_PILOT_LONGITUDE=-77.0369
SPATIAL_PILOT_RADIUS_METERS=1000

# Google connectors (Connectors → Connect Google)
# One OAuth client: Calendar read + Tasks write + Gmail read.
# Enable Calendar API, Tasks API, and Gmail API in Google Cloud Console.
# Authorized redirect URI must match exactly:
#   http://localhost:4000/v1/connectors/google/calendar/callback
# Existing users must Connect Google again to grant the new scopes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/v1/connectors/google/calendar/callback
API_PUBLIC_URL=http://localhost:4000
# Where Checkout and the portal return
APP_BASE_URL=http://localhost:3000
# Optional; defaults to GOOGLE_CLIENT_SECRET
CONNECTOR_STATE_SECRET=

# Stripe Pro — Checkout + Customer Portal. Prices are discovered from the
# pro_monthly / pro_annual lookup keys, with active Pro prices as fallback.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_ENABLED=false

# Twilio phone onboarding. TWILIO_MOCK=true never sends or purchases.
TWILIO_MOCK=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Keep false until an operator explicitly approves paid number purchases.
TWILIO_ENABLE_PHONE_PURCHASES=false
TWILIO_NUMBER_COUNTRY=US
# Display-only estimate shown before confirmation; check the Twilio console.
TWILIO_NUMBER_MONTHLY_USD=1.40

# External SMS is intentionally unavailable in this MVP. Adding it requires
# webhook signature validation, quotas, consent records, opt-out handling, and
# carrier registration approval.
EXTERNAL_SMS_ENABLED=false
