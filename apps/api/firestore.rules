rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isParty() {
      return signedIn() && (
        request.auth.uid == resource.data.fromId ||
        request.auth.uid == resource.data.toId
      );
    }

    function isPartyInList() {
      return signedIn() && request.auth.uid in resource.data.userIds;
    }

    match /users/{userId} {
      // Authenticated read for Nearby matching. Field-level privacy
      // (hide email/deviceId) still needs Cloud Functions or private docs.
      allow read: if signedIn();

      allow create: if signedIn() && (
        request.auth.uid == userId ||
        userId.matches('seed-.*')
      );

      allow update: if isSelf(userId);
      allow delete: if false;
    }

    match /connectionRequests/{requestId} {
      allow read: if isParty();

      allow create: if signedIn()
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.toId is string
        && request.resource.data.toId != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 200;

      // Recipient: accept or quiet-decline. Sender: cancel pending.
      allow update: if isParty()
        && resource.data.status == 'pending'
        && request.resource.data.fromId == resource.data.fromId
        && request.resource.data.toId == resource.data.toId
        && request.resource.data.pairId == resource.data.pairId
        && request.resource.data.message == resource.data.message
        && (
          (
            request.auth.uid == resource.data.toId
            && request.resource.data.status in ['accepted', 'declined']
          )
          || (
            request.auth.uid == resource.data.fromId
            && request.resource.data.status == 'cancelled'
          )
        );

      allow delete: if false;
    }

    match /connections/{connectionId} {
      allow read: if isPartyInList();

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.userIds
        && request.resource.data.userIds.size() == 2;

      allow update, delete: if false;
    }

    match /blocks/{blockId} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.blockerId ||
        request.auth.uid == resource.data.blockedId
      );

      allow create: if signedIn()
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId is string
        && request.resource.data.blockedId != request.auth.uid;

      allow update: if false;
      allow delete: if isSelf(resource.data.blockerId);
    }
  }
}
