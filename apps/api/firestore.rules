rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isParty() {
      return signedIn() && (
        request.auth.uid == resource.data.fromId ||
        request.auth.uid == resource.data.toId
      );
    }

    function isPartyInList() {
      return signedIn() && request.auth.uid in resource.data.userIds;
    }

    // Client updates may only touch profile fields — never billing.
    function profileFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'age', 'role', 'interests', 'photoUrl', 'bio', 'lookingFor',
        'prompts', 'vibes', 'deviceId', 'updatedAt', 'initials', 'avatarHue',
        'email', 'connectorSetupDismissedAt', 'timeZone'
      ]);
    }

    function noClientBillingOnCreate() {
      return (!('plan' in request.resource.data) || request.resource.data.plan == 'free')
        && (!('subscriptionStatus' in request.resource.data)
            || request.resource.data.subscriptionStatus == 'none')
        && !('stripeCustomerId' in request.resource.data
            && request.resource.data.stripeCustomerId != null)
        && !('stripeCustomerIdTest' in request.resource.data
            && request.resource.data.stripeCustomerIdTest != null)
        && !('stripeCustomerIdLive' in request.resource.data
            && request.resource.data.stripeCustomerIdLive != null)
        && !('stripeSubscriptionId' in request.resource.data
            && request.resource.data.stripeSubscriptionId != null)
        && !('promoCode' in request.resource.data
            && request.resource.data.promoCode != null)
        && !('seats' in request.resource.data
            && request.resource.data.seats != null)
        && !('teamOwnerId' in request.resource.data
            && request.resource.data.teamOwnerId != null)
        && !('referralCode' in request.resource.data
            && request.resource.data.referralCode != null)
        && (!('referralCount' in request.resource.data)
            || request.resource.data.referralCount == 0)
        && (!('teamMemberEmails' in request.resource.data)
            || request.resource.data.teamMemberEmails.size() == 0);
    }

    match /users/{userId} {
      // Authenticated read for Nearby matching. Field-level privacy
      // (hide email/deviceId) still needs Cloud Functions or private docs.
      allow read: if signedIn();

      allow create: if signedIn() && (
        request.auth.uid == userId ||
        userId.matches('seed-.*')
      ) && noClientBillingOnCreate();

      allow update: if isSelf(userId) && profileFieldsOnly();
      allow delete: if false;
    }

    match /connectionRequests/{requestId} {
      allow read: if isParty();

      allow create: if signedIn()
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.toId is string
        && request.resource.data.toId != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 200;

      // Recipient: accept or quiet-decline. Sender: cancel pending.
      allow update: if isParty()
        && resource.data.status == 'pending'
        && request.resource.data.fromId == resource.data.fromId
        && request.resource.data.toId == resource.data.toId
        && request.resource.data.pairId == resource.data.pairId
        && request.resource.data.message == resource.data.message
        && (
          (
            request.auth.uid == resource.data.toId
            && request.resource.data.status in ['accepted', 'declined']
          )
          || (
            request.auth.uid == resource.data.fromId
            && request.resource.data.status == 'cancelled'
          )
        );

      allow delete: if false;
    }

    match /connections/{connectionId} {
      allow read: if isPartyInList();

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.userIds
        && request.resource.data.userIds.size() == 2;

      allow update, delete: if false;
    }

    match /blocks/{blockId} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.blockerId ||
        request.auth.uid == resource.data.blockedId
      );

      allow create: if signedIn()
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId is string
        && request.resource.data.blockedId != request.auth.uid;

      allow update: if false;
      allow delete: if isSelf(resource.data.blockerId);
    }

    // Clip BLE sightings are written/read only via the API (Admin SDK).
    match /clipSightings/{sightingId} {
      allow read, write: if false;
    }

    // OAuth tokens for agent tools — API (Admin SDK) only.
    match /agentConnectors/{uid} {
      allow read, write: if false;
    }

    match /agentState/{uid} {
      allow read, write: if false;
    }

    // Team seat invites — API (Admin SDK) only.
    match /teamInvites/{email} {
      allow read, write: if false;
    }

    // Public marketing waitlist. Create/merge only; nobody reads from clients.
    match /waitlist/{entryId} {
      allow create: if request.resource.data.keys().hasAll(['email', 'createdAt', 'source'])
        && request.resource.data.keys().hasOnly(['email', 'createdAt', 'updatedAt', 'source'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 320
        && request.resource.data.source is string
        && request.resource.data.source.size() > 0
        && request.resource.data.source.size() <= 64
        && request.resource.data.createdAt is number;

      allow update: if request.resource.data.email == resource.data.email
        && request.resource.data.keys().hasOnly(['email', 'createdAt', 'updatedAt', 'source'])
        && request.resource.data.email is string
        && request.resource.data.source is string;

      allow read, delete: if false;
    }
  }
}
